# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
build/bin/
pollis
# Rust crates keep their CLI entrypoints under src/bin/ — those are source, not build output.
!verifiable-log/src/bin/
!verifiable-log-builder/src/bin/
!verifiable-log-serve/src/bin/
!pollis-relay/src/bin/

# Test binary
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/
# ...except this one, which is not a fetched dependency directory: it holds the
# SQLCipher amalgamation the Windows build compiles, checked in on purpose so
# the library that encrypts the local database is in the tree and not fetched
# at build time (#992). A directory has to be re-included before the files
# inside it can be.
!pollis-sqlcipher/vendor/

# Go workspace file
go.work

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/package-lock.json
frontend/package.json.md5
# pnpm-only repo — a root npm lockfile is a stray artifact, never commit it
/package-lock.json

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# ...except the SQLCipher cross-provider interop fixtures, which are checked-in
# artifacts rather than scratch: the whole point is that a DIFFERENT SQLCipher
# build wrote them, so they cannot be regenerated by the crate that reads them.
!pollis-sqlcipher/tests/fixtures/*.db

# User data (local)
.local/
.pollis/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Generated files
pkg/proto/gen/
site/v1
bundle.json
fixture.json

# Environment
.env.production
.env.development
.env.local

# Turborepo
.turbo

# Node modules (all locations)
node_modules/
**/node_modules/

temp/
.claude/
.mcp.json

src-tauri/target/
# Cargo workspace build output (repo root)
/target/
# Built screen-capture sidecar, staged by scripts/build-capture-helper.sh
src-tauri/binaries/
# The device keystore (pre-#950 name: dev-keystore.json). Never committed.
keystore.pks
dev-keystore.json

test-results/
playwright-report/
playwright/.cache/
# Local DB backups (never commit — contains encrypted envelopes/tokens)
db-backups/

# local env backups (never commit — contain real tokens)
.env.*.bak*
*.bak-rw

# Assistant (#508): the in-browser MiniLM runtime + model are intentionally vendored into the
# static site (user chose self-contained over CDN). Exempt them from the blanket vendor/ ignore.
!website/vendor/
!website/vendor/**

# TLA+ toolchain: scripts/tlc-check.sh downloads the pinned tla2tools.jar here.
scripts/tla2tools.jar
__pycache__/

# Ad-hoc sourcemap build used for bundle attribution — never committed.
frontend/dist-map/

# Terraform state — the relay pool's state lives in R2 (`pollis-tfstate`,
# see infra/relay-hydra/versions.tf). Nothing here should ever hold it: the
# 2026-08-12 R2 migration left a 301K `terraform.tfstate.backup` and a
# pre-migration snapshot sitting untracked in the tree for weeks, one
# `git add -A` away from committing the whole infrastructure state.
*.tfstate
*.tfstate.*
tfstate-*.json
.terraform/
