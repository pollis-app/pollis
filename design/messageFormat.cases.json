{
  "about": "Message formatting case table (#2142). Read by design/messageFormat.ts's tests (frontend/tests/message-format.test.ts, mobile/tests/message-format.test.ts) and by pollis-core/src/message_format.rs's. Tokens: a string is text; {\"b\"|\"i\"|\"u\"|\"s\": [...]} is bold, italic, underline, strikethrough; {\"code\": text, \"lang\": word|null} is a code block. `plain` is the preview text (markers stripped); `scan` is the mention/link scan text, when the case pins it.",
  "cases": [
    { "name": "plain text", "input": "hello there", "tokens": ["hello there"], "plain": "hello there" },
    { "name": "empty", "input": "", "tokens": [], "plain": "" },
    { "name": "bold", "input": "a **bold** word", "tokens": ["a ", { "b": ["bold"] }, " word"], "plain": "a bold word" },
    { "name": "italic with a star", "input": "an *italic* word", "tokens": ["an ", { "i": ["italic"] }, " word"], "plain": "an italic word" },
    { "name": "italic with an underscore", "input": "an _italic_ word", "tokens": ["an ", { "i": ["italic"] }, " word"], "plain": "an italic word" },
    { "name": "underline is Discord's double underscore", "input": "__under__", "tokens": [{ "u": ["under"] }], "plain": "under" },
    { "name": "strikethrough", "input": "~~gone~~ now", "tokens": [{ "s": ["gone"] }, " now"], "plain": "gone now" },
    { "name": "a single tilde is literal", "input": "~approx~", "tokens": ["~approx~"], "plain": "~approx~" },
    { "name": "bold italic", "input": "***both***", "tokens": [{ "b": [{ "i": ["both"] }] }], "plain": "both" },
    { "name": "underline italic", "input": "__*underline italic*__", "tokens": [{ "u": [{ "i": ["underline italic"] }] }], "plain": "underline italic" },
    { "name": "struck bold", "input": "~~**struck bold**~~", "tokens": [{ "s": [{ "b": ["struck bold"] }] }], "plain": "struck bold" },
    { "name": "underline around underscore italic", "input": "___x___", "tokens": [{ "u": [{ "i": ["x"] }] }], "plain": "x" },
    { "name": "bold inside italic", "input": "*a **b** c*", "tokens": [{ "i": ["a ", { "b": ["b"] }, " c"] }], "plain": "a b c" },
    { "name": "two spans", "input": "**a** and **b**", "tokens": [{ "b": ["a"] }, " and ", { "b": ["b"] }], "plain": "a and b" },
    { "name": "a span crosses a line break", "input": "**one\ntwo**", "tokens": [{ "b": ["one\ntwo"] }], "plain": "one\ntwo" },
    { "name": "markers alone stay literal", "input": "** and __ and ~~", "tokens": ["** and __ and ~~"], "plain": "** and __ and ~~" },
    { "name": "four stars stay literal", "input": "****", "tokens": ["****"], "plain": "****" },
    { "name": "spaced stars stay literal", "input": "* spaced *", "tokens": ["* spaced *"], "plain": "* spaced *" },
    { "name": "spaced double stars stay literal", "input": "** spaced **", "tokens": ["** spaced **"], "plain": "** spaced **" },
    { "name": "content may not end in a space", "input": "*a *", "tokens": ["*a *"], "plain": "*a *" },
    { "name": "arithmetic", "input": "2*3*4 = 24", "tokens": ["2*3*4 = 24"], "plain": "2*3*4 = 24" },
    { "name": "spaced arithmetic", "input": "2 * 3 * 4", "tokens": ["2 * 3 * 4"], "plain": "2 * 3 * 4" },
    { "name": "snake_case", "input": "open file_name_here now", "tokens": ["open file_name_here now"], "plain": "open file_name_here now" },
    { "name": "double underscores inside a word", "input": "a__b__c", "tokens": ["a__b__c"], "plain": "a__b__c" },
    { "name": "an underscore after an underscore inside a word", "input": "x__y_ z", "tokens": ["x__y_ z"], "plain": "x__y_ z" },
    { "name": "a double underscore after a dot underlines", "input": "call x.__init__()", "tokens": ["call x.", { "u": ["init"] }, "()"], "plain": "call x.init()" },
    { "name": "intraword stars follow GitHub", "input": "foo*bar*baz", "tokens": ["foo", { "i": ["bar"] }, "baz"], "plain": "foobarbaz" },
    { "name": "intraword double stars", "input": "un**frigging**believable", "tokens": ["un", { "b": ["frigging"] }, "believable"], "plain": "unfriggingbelievable" },
    { "name": "an unclosed marker is literal", "input": "**not closed", "tokens": ["**not closed"], "plain": "**not closed" },
    { "name": "a short closer", "input": "**x*", "tokens": ["*", { "i": ["x"] }], "plain": "*x" },
    { "name": "a long closer", "input": "*x**", "tokens": ["*x**"], "plain": "*x**" },
    { "name": "escaped stars", "input": "\\*not italic\\*", "tokens": ["*not italic*"], "plain": "*not italic*" },
    { "name": "escaped double stars", "input": "\\*\\*not bold\\*\\*", "tokens": ["**not bold**"], "plain": "**not bold**" },
    { "name": "escaped underscore and tilde", "input": "\\_a\\_ \\~~b~~", "tokens": ["_a_ ~~b~~"], "plain": "_a_ ~~b~~" },
    { "name": "an escaped backslash", "input": "\\\\*a*", "tokens": ["\\", { "i": ["a"] }], "plain": "\\a" },
    { "name": "other backslashes stay", "input": "C:\\Users\\me", "tokens": ["C:\\Users\\me"], "plain": "C:\\Users\\me" },
    { "name": "an escaped closer", "input": "*a\\*b*", "tokens": [{ "i": ["a*b"] }], "plain": "a*b" },
    { "name": "code block", "input": "```\nlet x = 1;\n```", "tokens": [{ "code": "let x = 1;", "lang": null }], "plain": "let x = 1;" },
    { "name": "code block with a language", "input": "```rust\nfn main() {}\n```", "tokens": [{ "code": "fn main() {}", "lang": "rust" }], "plain": "fn main() {}" },
    { "name": "nothing is parsed in code", "input": "```\n**not bold** @ann _x_ https://a.example :smile: \\*\n```", "tokens": [{ "code": "**not bold** @ann _x_ https://a.example :smile: \\*", "lang": null }], "plain": "**not bold** @ann _x_ https://a.example :smile: \\*", "scan": "" },
    { "name": "text around a code block", "input": "before **b**\n```\ncode\n```\nafter", "tokens": ["before ", { "b": ["b"] }, { "code": "code", "lang": null }, "after"], "plain": "before b\ncode\nafter" },
    { "name": "multi-line code keeps blank lines and indentation", "input": "```py\ndef f():\n\n    return 1\n```", "tokens": [{ "code": "def f():\n\n    return 1", "lang": "py" }], "plain": "def f():\n\n    return 1" },
    { "name": "an empty code block", "input": "```\n```", "tokens": [{ "code": "", "lang": null }], "plain": "" },
    { "name": "an unclosed fence is text", "input": "```\nhi **x**", "tokens": ["```\nhi ", { "b": ["x"] }], "plain": "```\nhi x" },
    { "name": "a second unclosed fence is text", "input": "```\na\n```\nb\n```", "tokens": [{ "code": "a", "lang": null }, "b\n```"], "plain": "a\nb\n```" },
    { "name": "two code blocks", "input": "```\na\n```\n```\nb\n```", "tokens": [{ "code": "a", "lang": null }, { "code": "b", "lang": null }], "plain": "a\nb" },
    { "name": "a fence must be its own line", "input": "see ```x``` here", "tokens": ["see ```x``` here"], "plain": "see ```x``` here" },
    { "name": "a fence line with more than a word is text", "input": "```js extra\ncode\n```", "tokens": ["```js extra\ncode\n```"], "plain": "```js extra\ncode\n```" },
    { "name": "fences tolerate spaces and CRLF", "input": "  ```  \r\ncode\r\n```\r\nafter", "tokens": [{ "code": "code\r", "lang": null }, "after"], "plain": "code\r\nafter" },
    { "name": "an escaped fence is text", "input": "\\```\nx\n```", "tokens": ["```\nx\n```"], "plain": "```\nx\n```" },
    { "name": "formatting does not cross a code block", "input": "**a\n```\nb\n```\nc**", "tokens": ["**a", { "code": "b", "lang": null }, "c**"], "plain": "**a\nb\nc**" },
    { "name": "a mention inside bold", "input": "hi **@ann_marie** there", "tokens": ["hi ", { "b": ["@ann_marie"] }, " there"], "plain": "hi @ann_marie there", "scan": "hi \n@ann_marie\n there" },
    { "name": "a mention with underscores is an atom", "input": "ping @_bob_ now", "tokens": ["ping @_bob_ now"], "plain": "ping @_bob_ now" },
    { "name": "a mention ends before trailing punctuation", "input": "_hi @bob_", "tokens": [{ "i": ["hi @bob"] }], "plain": "hi @bob" },
    { "name": "a link inside bold", "input": "**https://example.com/a_b_c**", "tokens": [{ "b": ["https://example.com/a_b_c"] }], "plain": "https://example.com/a_b_c" },
    { "name": "markers inside a link are part of it", "input": "see https://example.com/_x_/y and _z_", "tokens": ["see https://example.com/_x_/y and ", { "i": ["z"] }], "plain": "see https://example.com/_x_/y and z" },
    { "name": "a www link is an atom", "input": "*www.example.com/~a~~b*", "tokens": [{ "i": ["www.example.com/~a~~b"] }], "plain": "www.example.com/~a~~b" },
    { "name": "a custom emoji inside italic", "input": "*<:party_time:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef>*", "tokens": [{ "i": ["<:party_time:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef>"] }], "plain": "<:party_time:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef>" },
    { "name": "a shortcode is an atom", "input": "_:_x_:_", "tokens": [{ "i": [":_x_:"] }], "plain": ":_x_:" },
    { "name": "right-to-left text", "input": "**שלום** עולם _مرحبا_", "tokens": [{ "b": ["שלום"] }, " עולם ", { "i": ["مرحبا"] }], "plain": "שלום עולם مرحبا" },
    { "name": "underscores inside an Arabic word", "input": "مر_حب_ا", "tokens": ["مر_حب_ا"], "plain": "مر_حب_ا" },
    { "name": "emoji in spans", "input": "**👍🏽** ~~👨‍👩‍👧~~ __🎉__", "tokens": [{ "b": ["👍🏽"] }, " ", { "s": ["👨‍👩‍👧"] }, " ", { "u": ["🎉"] }], "plain": "👍🏽 👨‍👩‍👧 🎉" },
    { "name": "CJK in spans", "input": "今天**很好**", "tokens": ["今天", { "b": ["很好"] }], "plain": "今天很好" },
    { "name": "underscores between CJK stay literal", "input": "今天_很好_吧", "tokens": ["今天_很好_吧"], "plain": "今天_很好_吧" },
    { "name": "a lazy closer skips a spaced one", "input": "**a **b**", "tokens": [{ "b": ["a **b"] }], "plain": "a **b" },
    { "name": "a star next to a digit", "input": "**2**x and 5*x*", "tokens": [{ "b": ["2"] }, "x and 5*x*"], "plain": "2x and 5*x*" }
  ]
}
