# Copy to terraform.tfvars and adjust. All values have sensible defaults in
# variables.tf; this file only shows the ones you're most likely to touch.

# THE OFF SWITCH. Currently false in variables.tf — the pool is switched OFF: no
# ASGs, no nodes, no reconciler, no schedule. Prefer flipping the DEFAULT in
# variables.tf over setting it here, so the repo itself says whether the pool is
# meant to be running; terraform.tfvars is gitignored and nobody else can see it.
# Everything below only takes effect while this is true.
hydra_enabled = false

# Desired-state SEED: a POOL-WIDE count. Regions are not set here — the reconciler
# draws them at random from the allowed set and re-draws every rotation interval.
# (It owns runtime scaling after apply — edit the SSM desired-state param to scale;
# see README.) 3 nodes ≈ the $20/mo budget.
pool_node_count = 3

# Pool-wide clamps the reconciler applies to whatever desired-state says.
node_floor = 2
node_max   = 3

# 0 = all Spot. Set to 1 to make the first node in each occupied region on-demand —
# but it is PER-REGION, so a wide draw can push the pool over $20/mo. See README.
on_demand_base_per_region = 0

# How often placement is re-drawn.
rotation_interval_hours = 24

# Stable client-facing directory URL host. Requires a DNS CNAME + ACM validation
# (see README). Set to "" to use the raw *.cloudfront.net domain.
directory_domain = "relays.pollis.com"

# Verify against the CURRENT .env.production before apply (schemes/paths stripped).
relay_allowlist = "prod-actuallydan.aws-us-east-1.turso.io,api.pollis.com,4bd9ab176c5febd5e7ac1b64b23dede5.r2.cloudflarestorage.com,cdn.pollis.com,rtc.pollis.com"

# $20/mo hard cap alert. Add emails to get notified.
monthly_budget_usd  = 20
budget_alert_emails = []

# CloudWatch alarms (reconcile failures, Lambda errors, healthy-node floor) → SNS →
# email. Each address must confirm the subscription email AWS sends.
alarm_email_addresses = []
