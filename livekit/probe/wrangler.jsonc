{
  // Cloudflare Worker that watches the LiveKit stack from outside (src/index.ts).
  // Deploy by hand from this directory: livekit/DEPLOY.md → "External probe".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pollis-livekit-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "PROBE_STATE", "class_name": "ProbeStateObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeStateObject"] }],
  "vars": {
    "RTC_URL": "https://rtc.pollis.com/",
    "TURN_HOST": "turn.pollis.com",
    "TURN_PORT": "443",
    "GITHUB_REPO": "pollis-app/pollis",
    "RESTART_WORKFLOW": "livekit-restart.yml"
  },
  // Secrets, set once with `wrangler secret put <NAME>`:
  //   GITHUB_DISPATCH_TOKEN — fine-grained PAT, repository access = pollis-app/pollis
  //                           only, permission Actions: Read and write, nothing else.
  //   ALERT_WEBHOOK_URL     — optional incoming webhook (Discord/Slack style JSON).
  //
  // Same stance as the DS Worker configs (docs/metadata-retention-policy.md §3):
  // no request logging anywhere, even though this Worker only ever probes our
  // own servers and reads nothing from the requests it receives.
  "observability": { "enabled": false },
  "logpush": false
}
