        { "file": "website/retention.html", "pattern": "This is one of the {value} kinds of message loss Pollis accepts" },
        { "file": "learn/manim/scripts/joining-leaving.md", "pattern": "{value} kinds of loss are acceptable" },
        { "file": "learn/manim/scenes/joining_leaving.py", "pattern": "Exactly {value} kinds of loss are acceptable" },
        { "file": "docs/backend-core-invariants.md", "pattern": "the accepted losses stay exactly the {value} in" },
        { "file": "docs/backend-core-invariants.md", "pattern": "only ever classifies the {value} acceptable losses" }
      ]
    },

