{
  "_comment": [
    "THE registry of every public surface and content item (epic #1720, #1728). scripts/sweep.mjs reads it; it never owns another lane's data.",
    "",
    "axes        the dimensions a feature can vary on: platform, skin (desktop renderer only; mobile and the TUI have one look), store.",
    "content     EVERY public content item: each website page, /learn topic, public doc, user-facing README, installer and store listing.",
    "            source = the file a sweep edits; rendered = files (or globs) generated from it or shown with it; external = URLs of",
    "            copies that are not in git (R2 video); checked_by = the sweep dimensions that check it (see sweep.mjs --list);",
    "            policy: true = legal/policy page, flag-only (never edited by a sweep, #1720 'Policy vs code'); audience defaults to",
    "            public, 'linked-design' = an internal design doc a public page links to. locales defaults to defaults.locales.",
    "stores      every store a build or listing ships through, and what feeds it. Must match axes.store exactly.",
    "registration  the globs every tracked file under which must be claimed by a content item, a store or `internal` (with a reason).",
    "            sweep.mjs checks both directions: an unregistered file fails, and a registered path that matches nothing fails.",
    "internal    files under the registration globs that are deliberately NOT public content, each with the reason.",
    "features    only features whose behaviour varies by an axis (not the command inventory: that is feature-parity.json).",
    "            paths = the code that implements it (a change there makes the platform-matrix dimension due); excluded = axis",
    "            values it deliberately does not run on, with the reason.",
    "data_files  the other lanes' data files sweep.mjs reads. A missing one is reported as 'not yet built (#lane)', never as passing.",
    "",
    "Adding a public page or doc: add it under content in the same PR (node scripts/sweep.mjs surfaces tells you if you forgot).",
    "Not CI: like every drift sweep this runs by hand (/pre-release-sweeps) and never gates a merge."
  ],
  "axes": {
    "platform": [
      "ios-iphone",
      "ios-ipad",
      "android",
      "macos",
      "windows",
      "linux-x11",
      "linux-wayland",
      "tui"
    ],
    "skin": [
      "terminal",
      "refined"
    ],
    "skin_applies_to": [
      "macos",
      "windows",
      "linux-x11",
      "linux-wayland"
    ],
    "store": [
      "app-store",
      "play",
      "android-sideload",
      "aur",
      "github-release",
      "website-install"
    ]
  },
  "defaults": {
    "audience": "public",
    "locales": "en-only",
    "locales_reason": "Public website and docs are English-only today; the app UI is localised through frontend/src/i18n/locales (the i18n dimension)."
  },
  "registration": {
    "globs": [
      "website/*.html",
      "website/*.js",
      "website/*.sh",
      "website/*.json",
      "website/.well-known/*",
      "website/learn/media/*.vtt",
      "learn/manim/scripts/*.md",
      "learn/manim/scenes/*.py",
      "docs/**/*.md",
      "*.md",
      "**/README.md",
      "mobile/store/**"
    ]
  },
  "stores": {
    "app-store": {
      "about": "iOS + iPadOS App Store",
      "listing": [
        "store/listing",
        "store/release-notes-ios"
      ],
      "ships": "mobile store build (mobile/CLAUDE.md → Store builds), tag mobile-v*",
      "assets": "screenshots: not generated yet (#1729)"
    },
    "play": {
      "about": "Google Play",
      "listing": [
        "store/listing",
        "store/release-notes-android"
      ],
      "ships": "mobile store build, tag mobile-v*",
      "assets": "screenshots: not generated yet (#1729)"
    },
    "android-sideload": {
      "about": "Signed APK from cdn.pollis.com, linked from website/android.html",
      "listing": [
        "website/android",
        "store/android-sideload-cert"
      ],
      "ships": ".github/workflows/mobile-apk-release.yml"
    },
    "aur": {
      "about": "Arch User Repository package",
      "listing": [],
      "ships": ".github/workflows/aur-republish.yml + scripts/publish-aur.sh"
    },
    "github-release": {
      "about": "GitHub releases: desktop bundles, the pollis CLI, pollis-verify",
      "listing": [
        "readme/CHANGELOG"
      ],
      "ships": ".github/workflows/desktop-release.yml, cli-release.yml, verifier-release.yml"
    },
    "website-install": {
      "about": "curl | sh installers on pollis.com",
      "listing": [
        "installer/install.sh",
        "installer/cli-install.sh",
        "website/index"
      ],
      "ships": ".github/workflows/website-deploy.yml"
    }
  },
