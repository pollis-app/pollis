  "features": {
    "screen-capture": {
      "varies_on": [
        "platform"
      ],
      "platforms": [
        "macos",
        "windows",
        "linux-x11",
        "linux-wayland"
      ],
      "paths": [
        "pollis-core/src/commands/screenshare",
        "pollis-capture-linux",
        "pollis-capture-macos",
        "pollis-capture-proto"
      ],
      "note": "Linux has two backends: X11 (Xvfb-testable) and the Wayland portal (pollis-capture-linux/src/linux.rs probe_backend).",
      "excluded": {
        "mobile": "real-time media excluded by product decision (CLAUDE.md)",
        "tui": "terminal client has no media"
      }
    },
    "camera": {
      "varies_on": [
        "platform"
      ],
      "platforms": [
        "macos",
        "windows",
        "linux-x11",
        "linux-wayland"
      ],
      "paths": [
        "pollis-core/src/commands/camera",
        "pollis-capture-linux",
        "pollis-capture-macos"
      ],
      "excluded": {
        "mobile": "real-time media excluded by product decision",
        "tui": "terminal client has no media"
      }
    },
    "voice": {
      "varies_on": [
        "platform"
      ],
      "platforms": [
        "macos",
        "windows",
        "linux-x11",
        "linux-wayland"
      ],
      "paths": [
        "pollis-core/src/commands/voice",
        "pollis-core/src/commands/voice_apm.rs",
        "pollis-core/src/commands/voice_denoiser.rs",
        "pollis-core/src/commands/voice_e2ee.rs",
        "frontend/src/components/Voice"
      ],
      "note": "audio devices are per OS (CoreAudio, WASAPI, PulseAudio/PipeWire).",
      "excluded": {
        "mobile": "real-time media excluded by product decision",
        "tui": "terminal client has no media"
      }
    },
    "clipboard": {
      "varies_on": [
        "platform"
      ],
      "paths": [
        "src-tauri/src/clipboard.rs",
        "frontend/src/bridge/clipboard.ts",
        "frontend/src/utils/clipboardPaste.ts"
      ],
      "note": "X11 selections vs the Wayland data-device protocol vs NSPasteboard / Win32; mobile uses the OS share sheet."
    },
    "keystore": {
      "varies_on": [
        "platform"
      ],
      "paths": [
        "pollis-core/src/keystore.rs"
      ],
      "note": "OS keychain where one exists, machine-bound encrypted file where none does (#882)."
    },
    "terminal-io": {
      "varies_on": [
        "platform"
      ],
      "platforms": [
        "tui"
      ],
      "paths": [
        "pollis-core/src/commands/terminal_unix.rs",
        "pollis-core/src/commands/terminal_windows.rs",
        "pollis-core/src/commands/terminal_gate.rs",
        "pollis-tui/src"
      ],
      "note": "Unix pty vs Windows console."
    },
    "notifications": {
      "varies_on": [
        "platform"
      ],
      "paths": [
        "pollis-core/src/notify",
        "pollis-core/src/commands/push.rs",
        "src-tauri/src/tray.rs"
      ],
      "note": "APNs / FCM push with on-device decrypt on mobile; OS notification centre + tray on desktop."
    },
    "updates": {
      "varies_on": [
        "platform",
        "store"
      ],
      "paths": [
        "pollis-core/src/commands/update.rs",
        "frontend/src/components/UpdateScreen.tsx",
        "mobile/store/runtime-versions.json",
        "pollis-delivery/worker/updates.ts"
      ],
      "note": "Tauri updater per desktop OS; store review + signed OTA on mobile; AUR and the install scripts update differently."
    },
    "message-rendering": {
      "varies_on": [
        "platform",
        "skin"
      ],
      "paths": [
        "frontend/src/components/Message",
        "mobile/components/chat/MessageRow.tsx",
        "mobile/components/chat/MessageBody.tsx",
        "pollis-tui/src/content.rs"
      ],
      "note": "two desktop skins with separate branches, a native mobile row, and the TUI."
    },
    "composer": {
      "varies_on": [
        "platform",
        "skin"
      ],
      "paths": [
        "frontend/src/components/Message",
        "mobile/components/chat/Composer.tsx",
        "pollis-tui/src/app.rs"
      ],
      "note": "keyboard handling differs per OS and per skin; the mobile soft keyboard."
    },
    "two-pane-layout": {
      "varies_on": [
        "platform"
      ],
      "platforms": [
        "ios-ipad"
      ],
      "paths": [
        "mobile/components/MasterDetail.tsx",
        "mobile/components/pane"
      ],
      "note": "iPad only (mobile/.maestro/flows/ipad-two-pane.yaml)."
    }
  },
