<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately no LSFileQuarantineEnabled: it stamps com.apple.quarantine
	     on every file the process writes, including the bundle the in-app
	     updater installs, and a self-stamped bundle is translocated on its next
	     Finder launch and can never update again. Files handed to the user are
	     stamped explicitly instead (pollis-core/src/downloads.rs). -->
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pollis needs microphone access for voice channels</string>
	<key>NSCameraUsageDescription</key>
	<string>Pollis needs camera access to share your webcam in voice channels</string>
	<!-- Allow using an iPhone as a webcam (Continuity Camera); also silences the
	     AVCaptureDeviceTypeContinuityCamera warning the helper logs at enumeration. -->
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<!-- Screen sharing on macOS uses ScreenCaptureKit in-process; TCC
	     prompts the user on first capture attempt. macOS uses its own
	     system message regardless of this key on most OS versions, but
	     having it set is harmless and recommended by Apple's docs. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>Pollis needs screen recording access to share your screen in voice channels</string>
</dict>
</plist>
