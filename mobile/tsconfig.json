{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro does the bundling; tsc here only ever checks. Stating it in the
    // config (rather than relying on the `--noEmit` the script passes) is what
    // lets `allowImportingTsExtensions` below be accepted.
    "noEmit": true,
    // `mobile/tests/` runs under `node --test`, whose type stripping resolves
    // the specifier as written — so the imports carry `.ts` and tsc has to
    // accept them. The alternative was excluding the tests from typechecking
    // the way frontend/tsconfig.json does, which buys the same green run by
    // giving up the coverage.
    "allowImportingTsExtensions": true
  }
}
