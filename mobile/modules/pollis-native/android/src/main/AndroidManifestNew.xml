<!-- The manifest AGP >= 7.3 builds this library with (build.gradle `supportsNamespace`). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- #1599: the app's only FCM service. It subclasses expo-notifications' service, whose own
         declaration plugins/withRichPush.js removes from the app manifest. -->
    <service
      android:name="com.pollisnative.push.PollisMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- #1614: the tap target of every notification the rich-push handler posts. Invisible and out
         of Recents; it hands the tap to expo-notifications and brings the app forward. -->
    <activity
      android:name="com.pollisnative.push.PushTapActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
  </application>
</manifest>
