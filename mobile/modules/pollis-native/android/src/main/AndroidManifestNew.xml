<!-- The manifest AGP >= 7.3 builds this library with (build.gradle `supportsNamespace`). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- #1804: PushFetchService, which gives a message push's fetch network under Data Saver. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <application>
    <!-- #1599: the app's only FCM service. It subclasses expo-notifications' service, whose own
         declaration plugins/withRichPush.js removes from the app manifest. -->
    <service
      android:name="com.pollisnative.push.PollisMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- #1804: held around a message push's fetch; does no work itself. -->
    <service
      android:name="com.pollisnative.push.PushFetchService"
      android:exported="false"
      android:foregroundServiceType="remoteMessaging" />
    <!-- #1614: the tap target of every notification the rich-push handler posts. Invisible and out
         of Recents; it hands the tap to expo-notifications and brings the app forward. -->
    <activity
      android:name="com.pollisnative.push.PushTapActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <!-- #2100: where another app's share sheet sends a share. Disabled until someone signs in
         (PollisShareModule.setShareTargetEnabled), so a signed-out Pollis is not offered. Only
         these types: text, links, images, video and files. No share targets, no shortcuts and no
         chooser targets anywhere: the share sheet shows the app, never a chat
         (tests/android-share-intake.test.ts). -->
    <activity
      android:name="com.pollisnative.share.ShareIntakeActivity"
      android:enabled="false"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <data android:mimeType="text/*" />
      </intent-filter>
    </activity>
  </application>
</manifest>
